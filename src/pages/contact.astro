---
import Layout from '../layouts/Layout.astro';
import ContactForm from '../components/ContactForm';
import "../styles/global.css";
---

<Layout title="Contact Us" description="Get in touch with Scoops & Smiles Ice Cream.">

  <!-- Page Hero -->
  <section class="relative h-60 flex items-end overflow-hidden" style="background-color: #93c572;">
    <div class="absolute inset-0 bg-sprinkle-pattern opacity-30"></div>
    <div class="relative z-10 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 pb-10 w-full">
      <p class="font-script text-white/80 text-xl mb-1">We'd love to hear from you</p>
      <h1 class="font-display text-5xl font-bold text-white">Contact Us</h1>
    </div>
    <svg class="absolute bottom-0 w-full" viewBox="0 0 1200 40" xmlns="http://www.w3.org/2000/svg" preserveAspectRatio="none">
      <path d="M0,40 L0,20 C400,0 800,40 1200,20 L1200,40 Z" fill="#fff8e8"/>
    </svg>
  </section>

  <section class="py-16 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="grid grid-cols-1 lg:grid-cols-5 gap-16">

      <!-- Contact Info Sidebar -->
      <aside class="lg:col-span-2 space-y-8">
        <div>
          <h2 class="font-display text-2xl font-bold text-chocolate mb-6">Say Hello</h2>
          <div class="space-y-5">
            {[
              {
                icon: '📍',
                title: 'Address',
                lines: ['123 Sweet Street', 'Creamville, NY 10001'],
              },
              {
                icon: '📞',
                title: 'Phone',
                lines: ['(555) 123-4567'],
              },
              {
                icon: '✉️',
                title: 'Email',
                lines: ['hello@scoopsandsmiles.com'],
              },
            ].map(item => (
              <div class="flex gap-4 items-start">
                <div class="w-12 h-12 bg-strawberry/10 rounded-2xl flex items-center justify-center text-2xl flex-shrink-0">
                  {item.icon}
                </div>
                <div>
                  <div class="font-display font-bold text-chocolate text-sm mb-0.5">{item.title}</div>
                  {item.lines.map(l => <div class="font-body text-chocolate/70 text-sm">{l}</div>)}
                </div>
              </div>
            ))}
          </div>
        </div>

        <!-- Hours -->
        <div class="bg-cream-100 rounded-3xl p-6 border border-cream-200">
          <h3 class="font-display font-bold text-chocolate text-lg mb-4">🕐 Hours</h3>
          <div class="space-y-2 text-sm font-body">
            {[
              { day: 'Monday – Thursday', hours: '11:00 AM – 9:00 PM' },
              { day: 'Friday', hours: '11:00 AM – 10:00 PM' },
              { day: 'Saturday', hours: '10:00 AM – 10:00 PM' },
              { day: 'Sunday', hours: '10:00 AM – 9:00 PM' },
            ].map(h => (
              <div class="flex justify-between">
                <span class="text-chocolate/60">{h.day}</span>
                <span class="font-semibold text-chocolate">{h.hours}</span>
              </div>
            ))}
          </div>
        </div>

        <!-- Map placeholder -->
        <div class="rounded-3xl overflow-hidden shadow-md border border-cream-200 h-52 bg-cream-100 flex items-center justify-center text-chocolate/30">
          <div class="text-center">
            <div class="text-4xl mb-2">🗺️</div>
            <div class="text-sm font-body">Embed Google Maps here</div>
          </div>
        </div>
      </aside>

      <!-- Form -->
      <div class="lg:col-span-3">
        <div class="bg-white rounded-3xl p-8 shadow-sm border border-cream-200">
          <h2 class="font-display text-2xl font-bold text-chocolate mb-2">Send Us a Message</h2>
          <p class="font-body text-chocolate/60 text-sm mb-8">
            Whether it's a question, a catering inquiry, or just to say hi — we read every message and respond within one business day.
          </p>
          <ContactForm client:load />
        </div>
      </div>

    </div>
  </section>

</Layout>
